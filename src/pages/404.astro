---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base lang="tr" title="Sayfa bulunamadı · Deniz Arhın" description="Aradığın sayfa bu sitede yok." noindex>
  <main class="nf">
    <p class="code" aria-hidden="true">404</p>
    <h1>Bu sayfa yok.</h1>
    <p class="lead">Link eskimiş ya da yanlış yazılmış olabilir. Oyunlar ve iletişim bilgileri ana sayfada.</p>
    <p class="lead en" lang="en">This page doesn’t exist. The games and contact details are on the home page.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Ana sayfaya dön</a>
      <a class="btn btn-secondary" href="/#oyunlar"><Icon name="gamepad" /> Oyunlar</a>
      <a class="btn btn-ghost" href="/en/" lang="en">English</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: grid; align-content: center; gap: 16px;
    max-width: 640px; margin: 0 auto;
    padding: 48px var(--gutter);
  }
  .code {
    font-size: clamp(5rem, 16vw, 9rem); font-weight: 750; letter-spacing: -0.05em; line-height: 0.9;
    color: var(--surface-3);
  }
  h1 { font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 750; letter-spacing: -0.03em; line-height: 1.1; }
  .lead { color: var(--text-2); font-size: 1.0625rem; max-width: 52ch; }
  .lead.en { color: var(--text-3); font-size: 0.9375rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; padding: 10px 18px;
    font-size: 0.9375rem; font-weight: 550; line-height: 1.2;
    border-radius: var(--radius-sm); border: 1px solid transparent; text-decoration: none;
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }
  .btn-primary { background: var(--accent-strong); color: var(--accent-ink); }
  .btn-primary:hover { background: var(--accent-strong-hover); }
  .btn-secondary { background: var(--surface-2); border-color: var(--border-strong); color: var(--text); }
  .btn-secondary:hover { background: var(--surface-3); border-color: var(--border-hover); }
  .btn-ghost { color: var(--text-2); border-color: var(--border); }
  .btn-ghost:hover { color: var(--text); background: var(--surface-2); }
</style>
