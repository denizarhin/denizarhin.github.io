---
import Base from '../../../layouts/Base.astro';
import GamePage from '../../../components/GamePage.astro';
import { allGames } from '../../../data/details';
import { t } from '../../../data/site';

export function getStaticPaths() {
  return allGames.map((g) => ({ params: { slug: g.slug } }));
}
const { slug } = Astro.params;
const game = allGames.find((g) => g.slug === slug)!;
---
<Base lang="en" title={t.en.gameTitle(game.title)} description={game.pitch.en}
  path={`/en/games/${slug}/`} altPath={`/oyunlar/${slug}/`}>
  <GamePage lang="en" slug={slug!} />
</Base>
