---
import '../styles/global.css';
import { t, type Lang } from '../data/site';

interface Props {
  lang: Lang;
  /** Overrides for pages other than the home page. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** This page's path and its other-language path (defaults: the home pages). */
  path?: string;
  altPath?: string;
}
const { lang, title, description, noindex = false, path, altPath } = Astro.props;
const s = t[lang];
const pageTitle = title ?? s.htmlTitle;
const pageDescription = description ?? s.metaDescription;
const trPath = path ? (lang === 'tr' ? path : altPath!) : '/';
const enPath = path ? (lang === 'en' ? path : altPath!) : '/en/';
const trUrl = new URL(trPath, Astro.site).href;
const enUrl = new URL(enPath, Astro.site).href;
const canonical = lang === 'en' ? enUrl : trUrl;
const ogImage = new URL('/og.jpg', Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0f1115" />
    {noindex ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="tr" href={trUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={trUrl} />
      </>
    )}

    <!-- Link previews (LinkedIn, WhatsApp, X, Discord) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Deniz Arhın" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'tr_TR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deniz Arhın, oyun geliştirici, Son Hasat ana menüsü" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <slot />
  </body>
</html>
